if ARCH_VIRT

config SYS_VENDOR
	default "virt"

choice
	prompt "ARM architecture"
	default TARGET_VIRT_ARM_64BIT

config TARGET_VIRT_ARM_32BIT
	bool "ARMv7-A, 32bit"
	select ARCH_SUPPORT_PSCI
	select BOARD_LATE_INIT
	select CPU_V7A
	select SYS_ARCH_TIMER

config TARGET_VIRT_ARM_64BIT
	bool "ARMv8, 64bit"
	select ARM64
	select BOARD_LATE_INIT
endchoice

config SYS_BOARD
	default "arm"

config SYS_CONFIG_NAME
	default "virt-arm"

endif
